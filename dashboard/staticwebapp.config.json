{
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/common/v2.0",
          "clientIdSettingName": "AZURE_CLIENT_ID",
          "clientSecretSettingName": "AZURE_CLIENT_SECRET"
        },
        "login": {
          "loginParameters": [
            "scope=openid profile email"
          ]
        }
      }
    }
  },
  "routes": [
    {
      "route": "/login",
      "rewrite": "/.auth/login/aad"
    },
    {
      "route": "/oscs",
      "rewrite": "/oscs.html",
      "allowedRoles": [
        "etransparente_acesso"
      ]
    },
    {
      "route": "/osc",
      "rewrite": "/osc.html",
      "allowedRoles": [
        "etransparente_acesso"
      ]
    },
    {
      "route": "/feed",
      "rewrite": "/feed.html",
      "allowedRoles": [
        "etransparente_acesso"
      ]
    },
    {
      "route": "/envio",
      "rewrite": "/envio.html",
      "allowedRoles": [
        "etransparente_acesso"
      ]
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "etransparente_acesso"
      ]
    },
    {
      "route": "/*",
      "allowedRoles": [
        "etransparente_acesso"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/login",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/403.html",
      "statusCode": 403
    }
  },
  "globalHeaders": {
    "Access-Control-Allow-Origin": "*"
  },
  "platform": {
    "apiRuntime": "python:3.11"
  }
}